################################################################################
# CREDS File: Store private information. Copied to creds.env and always ignored
################################################################################
# Nautobot Configuration Secret Items
NAUTOBOT_CREATE_SUPERUSER=true
NAUTOBOT_DB_PASSWORD=changeme
NAUTOBOT_NAPALM_USERNAME=''
NAUTOBOT_NAPALM_PASSWORD=''
NAUTOBOT_REDIS_PASSWORD=changeme
NAUTOBOT_SECRET_KEY='changeme'
NAUTOBOT_SUPERUSER_NAME=admin
NAUTOBOT_SUPERUSER_EMAIL=admin@example.com
NAUTOBOT_SUPERUSER_PASSWORD=admin
NAUTOBOT_SUPERUSER_API_TOKEN=0123456789abcdef0123456789abcdef01234567

# Postgres
POSTGRES_PASSWORD=${NAUTOBOT_DB_PASSWORD}
PGPASSWORD=${NAUTOBOT_DB_PASSWORD}

# MySQL Credentials
MYSQL_ROOT_PASSWORD=${NAUTOBOT_DB_PASSWORD}
MYSQL_PASSWORD=${NAUTOBOT_DB_PASSWORD}

# Use these to override values in development.env
# NAUTOBOT_DB_HOST=localhost
# NAUTOBOT_REDIS_HOST=localhost
# NAUTOBOT_CONFIG=development/nautobot_config.py

# Layer8 Core API integration
# INSTANCE_FQDN is read by layer8_app.helpers.core_api.core_api_base_url() to build
# the API URL as `https://core-api.${INSTANCE_FQDN}`. Use the customer-facing FQDN
# of the Nautobot instance you want the dev container to talk to (e.g. for testing
# against the Vorboss prod-shaped Core API).
# INSTANCE_FQDN=vorboss.platform.layer8.io

###############################################################################
# Host-side env vars (NOT loaded into containers — set in your shell profile)
###############################################################################
#
# `invoke build` mints a short-lived GitHub App installation token before each
# build so the dev image can pip-install private deps (e.g. layer8-core-api-py-client).
# These three vars must be exported in your host shell (e.g. ~/.zshrc) — they are
# read by tasks.py, not by docker compose, so don't duplicate them into creds.env.
#
#   export LAYER8_GITHUB_APP_ID=1136755
#   export LAYER8_GITHUB_INSTALLATION_ID=60653383
#   export LAYER8_GITHUB_APP_PRIVATE_KEY="$HOME/.config/layer8/<app-name>.pem"
#
# If they are not set, `invoke build` will warn and proceed — but the pip install
# of private deps inside the image will fail with HTTP 401. The App must have
# `Contents: Read` on layer8-core-api-py-client (and any other private deps).
